---
import "../../styles/pages/tuto-hub.css";
import { makeStaticPaths, getLangFromParams } from "../../i18n/utils";
import type { TutoHubTranslations } from "../../i18n/translations/tuto-hub/types";
import { en } from "../../i18n/translations/tuto-hub/en";
import { fr } from "../../i18n/translations/tuto-hub/fr";
import { de } from "../../i18n/translations/tuto-hub/de";

export const getStaticPaths = makeStaticPaths("tuto-hub");

const lang = getLangFromParams(Astro.params);
const translations: Record<"en" | "fr" | "de", TutoHubTranslations> = { en, fr, de };
const t = translations[lang as "en" | "fr" | "de"];
---

<!-- HEADER =============================================== -->
<section class="custom-grid">
    <p class="custom-hub-eyebrow">{t.hero.eyebrow}</p>
    <h1 class="custom-hub-title">{t.hero.title}</h1>
    <p class="custom-hub-lede" set:html={t.hero.lede} />

    <!--
        Sommaire: disabled while there is a single chapter (Payment Settings).
        Kept in the code so it's a one-line uncomment once a second chapter
        exists — just remove the surrounding {/* ... */} below.
    -->
    {/*
    <nav class="custom-hub-toc" aria-label={t.toc.label}>
        <span class="custom-hub-toc__label">{t.toc.label}</span>
        <ol class="custom-hub-toc__list">
            {t.toc.items.map((item) => (
                <li>
                    <a class="custom-hub-toc__link" href={item.href}>
                        <span class="custom-hub-toc__num">{item.num}</span>
                        <span class="custom-hub-toc__txt">{item.label}</span>
                    </a>
                </li>
            ))}
        </ol>
    </nav>
    */}
</section>

<!-- SERVICES DE PAIEMENT ================================= -->
<section class="custom-grid" id="services-paiement">
    <div class="custom-hub-section-head">
        <span class="custom-hub-section-num" aria-hidden="true">{t.section.num}</span>
        <div>
            <h2 class="custom-hub-section-title">{t.section.title}</h2>
            <p class="custom-hub-section-sub">
                {t.section.subtitle}
            </p>
        </div>
    </div>

    <div class="custom-hub-grid">
        <!-- BTCPay Server (logo officiel inline) -->
        <a class="custom-hub-tile" href="/be-bop-io-configurer-btc-pay-server">
            <span class="custom-hub-logo" aria-hidden="true">
                <svg viewBox="0 0 105.46 188.47" xmlns="http://www.w3.org/2000/svg">
                    <path
                        fill="#cedc21"
                        d="M117.24,247.32a11.06,11.06,0,0,1-11-11.06V69.91a11.06,11.06,0,1,1,22.11,0V236.26A11.06,11.06,0,0,1,117.24,247.32Z"
                        transform="translate(-106.19 -58.85)"></path>
                    <path
                        fill="#51b13e"
                        d="M117.25,247.32a11.06,11.06,0,0,1-4.75-21l66.66-31.64L110.69,144.2a11.05,11.05,0,1,1,13.11-17.8l83.35,61.41a11,11,0,0,1-1.82,18.88L122,246.25A10.94,10.94,0,0,1,117.25,247.32Z"
                        transform="translate(-106.19 -58.85)"></path>
                    <path
                        fill="#cedc21"
                        d="M117.25,181.93a11.05,11.05,0,0,1-6.56-20l68.47-50.45L112.5,79.89a11.05,11.05,0,0,1,9.48-20l83.35,39.56a11.05,11.05,0,0,1,1.82,18.89L123.8,179.78A11,11,0,0,1,117.25,181.93Z"
                        transform="translate(-106.19 -58.85)"></path>
                    <polygon fill="#1e7a44" points="22.11 70.86 22.11 117.61 53.82 94.25 22.11 70.86"
                    ></polygon>
                    <rect fill="#fff" y="51.26" width="22.11" height="53.89"></rect>
                    <path
                        fill="#cedc21"
                        d="M128.3,69.91a11.06,11.06,0,1,0-22.11,0V209H128.3Z"
                        transform="translate(-106.19 -58.85)"></path>
                </svg>
            </span>
            <div class="custom-hub-tile__body">
                <span class="custom-hub-tile__name">{t.tiles.btcpay.name}</span>
                <span class="custom-hub-tile__kind">{t.tiles.btcpay.kind}</span>
                <span class="custom-hub-tile__cta">
                    {t.tiles.btcpay.cta}
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                            d="M5 12h14M13 6l6 6-6 6"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </span>
            </div>
        </a>

        <!-- PayPal (logo officiel inline) -->
        <a class="custom-hub-tile" href="/be-bop-io-configurer-paypal">
            <span class="custom-hub-logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="#002991" xmlns="http://www.w3.org/2000/svg"
